rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string && data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 50 &&
               data.coins is int && data.coins >= 0 &&
               data.level is int && data.level >= 1;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn() && isEmailVerified() &&
                      isValidId(userId) && userId == request.auth.uid &&
                      isValidUser(incoming()) &&
                      incoming().createdAt == request.time;

      allow update: if isOwner(userId) &&
                      isValidUser(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().coins == existing().coins &&
                      incoming().level == existing().level &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'isLive']);
    }

    // --- Stream Rules ---
    match /streams/{streamId} {
      function isValidStream(data) {
        return data.hostId is string && data.hostId.size() <= 128 &&
               data.hostName is string && data.hostName.size() <= 100 &&
               data.title is string && data.title.size() <= 100 &&
               data.status in ['active', 'ended'];
      }

      // Allow public discovery of active streams
      allow list: if resource.data.status == 'active';
      allow get: if true;

      allow create: if isSignedIn() && isEmailVerified() &&
                      isValidId(streamId) &&
                      isValidStream(incoming()) &&
                      incoming().hostId == request.auth.uid &&
                      incoming().startedAt == request.time &&
                      incoming().viewerCount == 0;

      allow update: if isSignedIn() && isValidStream(incoming()) && (
        // Action: Join/Leave (Update viewer count)
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount']) && 
         incoming().viewerCount is int &&
         incoming().viewerCount >= 0) ||
        // Action: End Stream (Exclusive to Host)
        (isOwner(existing().hostId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'viewerCount']) &&
         existing().status == 'active' &&
         incoming().status == 'ended')
      );
    }

    // --- Chat Message Rules ---
    match /streams/{streamId}/messages/{messageId} {
      function isValidMessage(data) {
        return data.senderId is string && data.senderId == request.auth.uid &&
               data.senderName is string &&
               data.text is string && data.text.size() <= 500 &&
               data.type in ['text', 'gift'];
      }

      allow read: if true; // Public chats for discoverability

      allow create: if isSignedIn() && isEmailVerified() &&
                      isValidMessage(incoming()) &&
                      incoming().timestamp == request.time &&
                      get(/databases/$(database)/documents/streams/$(streamId)).data.status == 'active';
    }
  }
}
